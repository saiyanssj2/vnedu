{
  "manifest_version": 3,
  "name": "VnEdu Nhận Xét AI",
  "version": "1.0.0",
  "description": "Tự động sinh nhận xét học sinh bằng AI và điền vào vnEdu",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.vnedu.vn/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.vnedu.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
